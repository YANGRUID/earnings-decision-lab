{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "screenshots": "tsx scripts/capture_screenshots.ts",
    "screenshots:v3": "tsx scripts/capture_v3_screenshots.ts",
    "test:e2e": "playwright test --project=chromium e2e/options-decision-engine.spec.ts",
    "test:e2e:live": "playwright test --project=chromium e2e/avgo-live.spec.ts",
    "test:e2e:ibkr": "playwright test --config=playwright.ibkr.config.ts --project=chromium",
    "test:e2e:operations": "playwright test --config=playwright.operations.config.ts --project=chromium"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "playwright": "^1.61.1",
    "tsx": "^4.23.12",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^6.4.3"
  }
}
