# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=earnings_decision_lab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5433/earnings_decision_lab

# --- Market / earnings / options data providers ---
# Provider choice is documented in docs/data_sources.md and docs/engineering_decisions.md.
# Free tier signup: tiingo.com/account/api/token
TIINGO_API_KEY=
# Free tier signup: alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
OPTIONS_DATA_API_KEY=
# Phase 4 -- the AI Benchmark Portfolio's forward-looking earnings calendar
# (providers/finnhub.py). Free tier signup: finnhub.io/register. Separate
# from ALPHA_VANTAGE_API_KEY above: the existing per-ticker research flow
# still uses Alpha Vantage, unchanged.
FINNHUB_API_KEY=

# Which options-chain provider to use. One of: alpha_vantage | ibkr
OPTIONS_PROVIDER=alpha_vantage

# --- Interactive Brokers Client Portal Gateway (Phase 13/4.8A, optional) ---
# Two supported workflows, both against the same REST Gateway
# (providers/ibkr_client.py never changes between them):
#
# 1. Manual (Phase 13, original): you run the Gateway yourself on your own
#    machine and log in via browser at https://localhost:5001 every
#    session -- this project never stores or handles your IBKR username,
#    password, or 2FA in this workflow. See docs/ibkr_integration.md.
# 2. Automated (Phase 4.8A): docker-compose.yml's ibkr-gateway service runs
#    the same Gateway inside a container and logs in for you via IBeam
#    (github.com/Voyz/ibeam), so it stays authenticated 24/7 without a
#    human re-logging in every few hours. See docs/ibkr_gateway_runtime.md
#    for the full setup, 2FA options, and what this actually changes about
#    where your credentials live. READ-ONLY, same as every IBKR path in
#    this project: nothing here ever calls an order-placement endpoint.
#
# Only used when OPTIONS_PROVIDER=ibkr. Leave IBKR_ACCOUNT/IBKR_PASSWORD
# below blank to use workflow 1 unchanged.
#
# host.docker.internal is what a container needs to reach a Gateway running
# on the host (docker-compose.yml's backend service maps this to the host on
# every platform, not just Docker Desktop) -- port 5000 is the new
# ibkr-gateway container (workflow 2, published to the host since it must
# run with network_mode: bridge -- see docker-compose.yml), port 5001 is a
# manually-run Gateway on your own machine (workflow 1). Running the
# backend directly on the host instead (no Docker) needs plain localhost --
# change this if that's your setup.
IBKR_BASE_URL=https://host.docker.internal:5000/v1/api

# --- IBKR Gateway automation credentials (Phase 4.8A, optional) ---
# Read ONLY by the new ibkr-gateway container (docker-compose.yml) -- the
# backend application code never reads these, exactly as before this
# phase; it only ever reads IBKR_BASE_URL above. Leave both blank to keep
# using workflow 1 (manual, no credentials held anywhere in this project).
#
# This is a real, meaningful step up in sensitivity from every other key
# in this file: it is your live IBKR brokerage login, not a read-only
# market-data API key. Never commit a filled-in .env. See
# docs/ibkr_gateway_runtime.md's Security section before filling these in.
IBKR_ACCOUNT=
IBKR_PASSWORD=
# Optional: a Fernet key IBeam uses to decrypt IBKR_PASSWORD if you'd
# rather store it encrypted than in plaintext. Unrelated to this
# project's own SECRET_STORE_MASTER_KEY below. See docs/ibkr_gateway_
# runtime.md and github.com/Voyz/ibeam's "Advanced secrets" docs.
IBKR_PASSWORD_KEY=

# Two-factor handling for unattended login. IBKR does not support
# disabling 2FA outright for API sessions (confirmed by IBKR to IBeam's
# own maintainers -- see docs/ibkr_gateway_runtime.md). The only handler
# capable of genuinely unattended operation is PYOTP, which requires your
# IBKR account's second factor to be a TOTP authenticator (set this up in
# IBKR Account Management > Secure Login System first) rather than
# push-only IBKR Mobile approval. Leave blank to require a manual 2FA tap
# on every fresh login (still automates everything else). One of:
# (blank) | PYOTP | GOOGLE_MSG | EXTERNAL_REQUEST
IBKR_TWO_FA_HANDLER=
# Base32 TOTP secret from IBKR's Secure Login System setup (looks like
# JBSWY3DPEHPK3PXP). Required only when IBKR_TWO_FA_HANDLER=PYOTP.
IBKR_PYOTP_SECRET=

# SEC EDGAR requires a real contact (per https://www.sec.gov/os/webmaster-faq#developers) in
# the User-Agent of every request. Set this to "Your Name your@email.com" before running any
# EDGAR ingestion — requests with a placeholder address are not compliant with SEC's policy.
SEC_EDGAR_USER_AGENT=Your Name your@email.com

# --- LLM provider (provider-agnostic — see docs/llm_providers.md) ---
# Selects which section below is required at runtime. One of:
# deepseek | openai | anthropic | openai_compatible
LLM_PROVIDER=deepseek

# DeepSeek (OpenAI-compatible transport). Signup: platform.deepseek.com
# Current model IDs (verified against api-docs.deepseek.com, 2026-08):
# deepseek-v4-flash (fast/non-thinking) or deepseek-v4-pro (thinking/quality).
# deepseek-chat/deepseek-reasoner were deprecated 2026-07-24 — do not use.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Any other OpenAI-compatible endpoint (local model server, another vendor, etc.)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
