# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=earnings_decision_lab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/earnings_decision_lab

# --- Market / earnings / options data providers ---
# Provider choice is documented in docs/data_sources.md and docs/engineering_decisions.md.
MARKET_DATA_API_KEY=
OPTIONS_DATA_API_KEY=
EARNINGS_CALENDAR_API_KEY=

# --- LLM provider ---
ANTHROPIC_API_KEY=
LLM_MODEL=

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
