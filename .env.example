# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=earnings_decision_lab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5433/earnings_decision_lab

# backend/tests/conftest.py never reads DATABASE_URL above -- pytest uses
# its own, completely separate disposable Postgres (the existing
# edl-test-db container, port 5434 by default; see conftest.py's own
# module-level comment) and refuses to start if that ever resolves to
# the same database as DATABASE_URL. Only needed here if you want to
# point pytest at something other than the port-5434 default.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5434/earnings_decision_lab

# --- Market / earnings / options data providers ---
# Provider choice is documented in docs/data_sources.md and docs/engineering_decisions.md.
# Free tier signup: tiingo.com/account/api/token
TIINGO_API_KEY=
# Free tier signup: alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
OPTIONS_DATA_API_KEY=
# The AI Benchmark Portfolio's forward-looking earnings calendar
# (providers/earningsapi.py) -- PRIMARY source. Free tier: 100 req/day,
# 1000/month; the daily sync's own per-date dedup (services/
# earnings_calendar_sync.py) keeps real usage to roughly 1-3 requests/day.
# Free tier signup: earningsapi.com
EARNINGSAPI_API_KEY=
# Same calendar's FALLBACK source (providers/finnhub.py), used only if
# EarningsAPI.com is unreachable or unconfigured -- its own free tier was
# confirmed to return far-future placeholder dates once its near-term
# coverage ran out, which is why it was demoted rather than dropped. Free
# tier signup: finnhub.io/register. Separate from ALPHA_VANTAGE_API_KEY
# above: the existing per-ticker research flow still uses Alpha Vantage,
# unchanged.
FINNHUB_API_KEY=

# Which options-chain provider to use. One of: alpha_vantage | ibkr
OPTIONS_PROVIDER=alpha_vantage

# --- Interactive Brokers Client Portal Gateway -- LEGACY / ROLLBACK ---
#
# ROLLBACK TRANSPORT ONLY as of the 2026-09-01 TWS cutover. Production is
# now IBKR_PROVIDER=tws (IB Gateway / TWS socket API -- see that block
# further down). Everything in this section is retained, working, and
# fully supported so a rollback to Web is a configuration change rather
# than a code change -- but it is no longer the normal path, and the
# "log in via browser every session" workflow described below is NOT how
# production authenticates today.
#
# Rollback procedure: set IBKR_PROVIDER=web, close the TWS brokerage
# session, authenticate the Client Portal Gateway, restart the backend.
# (IBKR allows only one brokerage session per username, so TWS must be
# closed before Web can authenticate.) There is deliberately NO automatic
# cross-provider failover -- switching transports is always a human
# decision.
#
# Two supported workflows, both against the same REST Gateway
# (providers/ibkr_client.py never changes between them):
#
# 1. Manual (Phase 13, original): you run the Gateway yourself on your own
#    machine and log in via browser at https://localhost:5001 every
#    session -- this project never stores or handles your IBKR username,
#    password, or 2FA in this workflow. See docs/ibkr_integration.md.
# 2. Automated (Phase 4.8A): docker-compose.yml's ibkr-gateway service runs
#    the same Gateway inside a container and logs in for you via IBeam
#    (github.com/Voyz/ibeam), so it stays authenticated 24/7 without a
#    human re-logging in every few hours. See docs/ibkr_gateway_runtime.md
#    for the full setup, 2FA options, and what this actually changes about
#    where your credentials live. READ-ONLY, same as every IBKR path in
#    this project: nothing here ever calls an order-placement endpoint.
#
# Only used when OPTIONS_PROVIDER=ibkr. Leave IBKR_ACCOUNT/IBKR_PASSWORD
# below blank to use workflow 1 unchanged.
#
# host.docker.internal is what a container needs to reach a Gateway running
# on the host (docker-compose.yml's backend service maps this to the host on
# every platform, not just Docker Desktop) -- port 5000 is the new
# ibkr-gateway container (workflow 2, published to the host since it must
# run with network_mode: bridge -- see docker-compose.yml), port 5001 is a
# manually-run Gateway on your own machine (workflow 1). Running the
# backend directly on the host instead (no Docker) needs plain localhost --
# change this if that's your setup.
IBKR_BASE_URL=https://host.docker.internal:5000/v1/api

# --- IBKR Gateway automation credentials (Phase 4.8A, optional) ---
# Read ONLY by the new ibkr-gateway container (docker-compose.yml) -- the
# backend application code never reads these, exactly as before this
# phase; it only ever reads IBKR_BASE_URL above. Leave both blank to keep
# using workflow 1 (manual, no credentials held anywhere in this project).
#
# This is a real, meaningful step up in sensitivity from every other key
# in this file: it is your live IBKR brokerage login, not a read-only
# market-data API key. Never commit a filled-in .env. See
# docs/ibkr_gateway_runtime.md's Security section before filling these in.
# Plain text. IBKR_PASSWORD_KEY (Fernet-encrypted password support) is
# NOT wired into docker-compose.yml yet -- a real, live-verified bug was
# found and removed during setup: IBeam treats that variable's mere
# presence (even empty) as "decrypt this," which broke plain-text login
# outright. See docs/ibkr_gateway_runtime.md's Troubleshooting section.
IBKR_ACCOUNT=
IBKR_PASSWORD=

# Two-factor handling for unattended login. IBKR does not support
# disabling 2FA outright for API sessions (confirmed by IBKR to IBeam's
# own maintainers -- see docs/ibkr_gateway_runtime.md). The only handler
# capable of genuinely unattended operation is PYOTP, which requires your
# IBKR account's second factor to be a TOTP authenticator (set this up in
# IBKR Account Management > Secure Login System first) rather than
# push-only IBKR Mobile approval. Leave blank to require a manual 2FA tap
# on every fresh login (still automates everything else). One of:
# (blank) | PYOTP | GOOGLE_MSG | EXTERNAL_REQUEST
IBKR_TWO_FA_HANDLER=
# Base32 TOTP secret from IBKR's Secure Login System setup (looks like
# JBSWY3DPEHPK3PXP). Required only when IBKR_TWO_FA_HANDLER=PYOTP.
IBKR_PYOTP_SECRET=

# Host ports the ibkr-gateway container's Gateway REST API (5000) and
# IBeam's own health server (5001) are published on -- change only if
# either port conflicts with something else already running on your
# machine. GET /api/v1/ibkr/connect (Settings -> Interactive Brokers'
# "Connect IBKR" button) uses IBKR_GATEWAY_PORT to build the browser-
# facing login URL, so if you change it here, that button follows
# automatically -- no code change needed.
IBKR_GATEWAY_PORT=5000
IBKR_GATEWAY_HEALTH_PORT=5001

# --- IBKR transport: TWS is PRODUCTION as of the 2026-09-01 cutover ---
# Selects which real IBKR transport a constructed "ibkr" options provider
# uses -- separate from OPTIONS_PROVIDER above (which chooses IBKR vs. a
# different data vendor entirely). One of: web | tws.
#
#   tws  = IB Gateway / TWS socket API. THIS IS THE PRODUCTION TRANSPORT
#          in the maintainer's own deployment as of 2026-09-01. Market
#          data is DELAYED there and is labeled DELAYED everywhere.
#   web  = the Client Portal Gateway / IBeam integration configured above.
#          RETAINED AS MANUAL ROLLBACK ONLY -- no longer the production
#          path, and there is no automatic failover between the two.
#
# This example file still ships "web" as its committed default because a
# fresh clone has no IB Gateway running and no live entitlements; that is
# a safe starting point, NOT a statement about what production uses.
# Note IBKR permits only ONE brokerage session per username, so the Web
# and TWS sessions cannot both be authenticated at the same time.
# See docs/ibkr_architecture.md for the current production architecture.
IBKR_PROVIDER=web

# IB Gateway / TWS's own socket API host/port -- only used when
# IBKR_PROVIDER=tws. host.docker.internal reaches a Gateway/TWS running on
# your own host machine (this project recommends running IB Gateway on the
# host rather than containerizing it).
#
# Well-known IBKR ports: IB Gateway live=4001, IB Gateway paper=4002,
# TWS live=7496, TWS paper=7497.
#
# IMPORTANT -- do not blindly keep 4002. This file defaults to the PAPER
# port as a safe starting value for a fresh clone, but the maintainer's
# own production deployment runs IB Gateway LIVE on 4001 and sets
# IBKR_TWS_PORT=4001 explicitly in its real .env. A mismatch here is
# silent and total: nothing listens on the wrong port, so every options
# request fails. Always set this to match the Gateway you actually run,
# and confirm whether that Gateway is live or paper before you do.
IBKR_TWS_HOST=host.docker.internal
IBKR_TWS_PORT=4002

# A fixed, deterministic client id for this service's TWS connection --
# never random (IB Gateway/TWS rejects a second connection that reuses an
# already-active client id). backend's own connection (and the health
# probe, which uses this value +900) uses this one.
IBKR_TWS_CLIENT_ID=101

# research-worker's own distinct client id (docker-compose.yml overrides
# that service's own IBKR_TWS_CLIENT_ID with this value) -- confirmed
# live during Phase 2 parity testing: research-worker's real options-
# chain fetch is substantial, not a lightweight probe, so it genuinely
# needs a working TWS connection once IBKR_PROVIDER=tws; sharing
# backend's own id would collide (error 326) the moment both connect.
# Change only if it conflicts with something else already running.
#
# Canonical TWS client-id ownership (no ad-hoc production ids):
#   101  backend production provider (one shared, long-lived connection)
#   1001 backend TWS health probe   (IBKR_TWS_CLIENT_ID + 900)
#   102  research-worker            (this value; its own process, its own
#        single shared connection for that process's lifetime)
IBKR_TWS_RESEARCH_WORKER_CLIENT_ID=102

# --- Internal diagnostics (default OFF) ---
# Opt-in gate for the read-only, in-process TWS diagnostic endpoint
# (GET /api/v1/internal/ibkr/tws-production-sanity). It performs real
# underlying + option market-data requests against the shared production
# TWS connection, writes nothing to the database, and exposes no
# credentials -- but like every endpoint in this local-first deployment it
# is unauthenticated, so it is NOT registered unless you explicitly turn
# it on. Useful for confirming the shared TWS connection can actually
# serve market data after a restart or a rollback.
ENABLE_INTERNAL_DIAGNOSTICS=false

# SEC EDGAR requires a real contact (per https://www.sec.gov/os/webmaster-faq#developers) in
# the User-Agent of every request. Set this to "Your Name your@email.com" before running any
# EDGAR ingestion — requests with a placeholder address are not compliant with SEC's policy.
SEC_EDGAR_USER_AGENT=Your Name your@email.com

# Operations Monitor's "missed official processing" critical alert only
# fires for a real due event at or after this timestamp (observability
# only -- see core/config.py's own docstring). Leave unset (no boundary,
# every real gap is reported) until you actually start live forward
# testing, then set it once to that moment, e.g.:
# FORWARD_TEST_ACTIVATION_AT=2026-08-25T00:00:00Z

# --- LLM provider (provider-agnostic — see docs/llm_providers.md) ---
# Selects which section below is required at runtime. One of:
# deepseek | openai | anthropic | openai_compatible
LLM_PROVIDER=deepseek

# DeepSeek (OpenAI-compatible transport). Signup: platform.deepseek.com
# Current model IDs (verified against api-docs.deepseek.com, 2026-09-02):
# deepseek-v4-flash (smaller/faster) and deepseek-v4-pro (larger). BOTH
# support thinking mode; the API enables it by default with effort "high".
# This application always sends an explicit thinking configuration per
# call path (see services/llm/deepseek.py) instead of relying on that
# default. deepseek-chat/deepseek-reasoner were deprecated 2026-07-24.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# General-purpose model: research preparation, AI Research and the official
# V3 decision engine (thinking disabled on those paths). NOT the V4 model.
DEEPSEEK_MODEL=deepseek-v4-flash

# --- V4 DecisionView model (explicit, auditable, persisted with every view) ---
# The model that produces the V4 shadow cohort's frozen DecisionView.
# Deliberately separate from DEEPSEEK_MODEL: a forward-test cohort's model
# is a versioned decision, never inherited from the research jobs. When V4
# is enabled and this is unset or invalid, V4 view generation fails with a
# clear configuration error -- there is no fallback to another model.
# Verified request shape (api-docs.deepseek.com/api/create-chat-completion):
#   "thinking": {"type": "enabled"|"disabled", "reasoning_effort": "low"|"high"|"max"}
# Thinking mode counts hidden reasoning tokens against max_tokens, so the
# budget must be far larger than the visible JSON answer (minimum 4096).
V4_DECISION_VIEW_MODEL=deepseek-v4-pro
V4_DECISION_VIEW_THINKING=enabled
V4_DECISION_VIEW_REASONING_EFFORT=high
V4_DECISION_VIEW_MAX_TOKENS=16384

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Any other OpenAI-compatible endpoint (local model server, another vendor, etc.)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
