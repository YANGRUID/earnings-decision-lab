# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Env / secrets ---
.env
.env.*
!.env.example
# Vite convention: committed, contains no secrets (just the local API URL).
# Personal overrides go in frontend/.env.development.local, still ignored.
!frontend/.env.development
*.pem
*.key
secrets/

# --- Databases / data ---
*.sqlite3
*.db
/data/
/backend/data/
*.parquet

# Large or licensed source documents (filings/transcripts) are not committed.
/backend/src/rag/store/
/evaluation/results/*.json
!/evaluation/results/.gitkeep

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Docker ---
*.pid

# --- Logs ---
*.log
logs/
