# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Env / secrets ---
.env
.env.*
!.env.example
# Vite convention: committed, contains no secrets (just the local API URL).
# Personal overrides go in frontend/.env.development.local, still ignored.
!frontend/.env.development
*.pem
*.key
secrets/

# --- Databases / data ---
*.sqlite3
*.db
/data/
/backend/data/
*.parquet

# Large or licensed source documents (filings/transcripts) are not committed.
/backend/src/rag/store/

# --- IBKR TWS API official source (IBKR TWS Migration Phase 1.1) ---
# The IB API Non-Commercial License explicitly prohibits redistribution
# ("You agree not to publish, disseminate, or redistribute the API Code
# to any third party") -- this repository is PUBLIC on GitHub, so the
# official source itself is fetched and SHA256-verified at setup/build
# time (backend/scripts/fetch_ibapi_official.sh) instead of being
# committed. Only PROVENANCE.md (metadata: URL/version/hash, not the
# licensed code itself) is tracked -- see that file for the exact
# version and checksum.
/backend/vendor/ibapi_official/pythonclient/
/backend/vendor/ibapi_official/*.zip
/evaluation/results/*.json
!/evaluation/results/.gitkeep

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Docker ---
*.pid

# --- Logs ---
*.log
logs/

# --- Local Claude Code tooling (browser launch config etc.) ---
.claude/
